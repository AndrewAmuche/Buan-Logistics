{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile shared between web dashboard and mobile app",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "accountType": { "type": "string" },
        "role": { "type": "string" },
        "businessName": { "type": "string" },
        "corporateTier": { "type": "string" },
        "subscriptionTier": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "city": { "type": "string" },
        "country": { "type": "string" }
      },
      "required": ["id", "fullName", "email"]
    },
    "Shipment": {
      "title": "Shipment",
      "description": "Logistics shipment record shared between web portal and mobile app",
      "type": "object",
      "properties": {
        "trackingNumber": { "type": "string" },
        "userId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderPhone": { "type": "string" },
        "senderAddress": { "type": "string" },
        "senderCity": { "type": "string" },
        "senderCountry": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverEmail": { "type": "string" },
        "receiverPhone": { "type": "string" },
        "receiverAddress": { "type": "string" },
        "receiverCity": { "type": "string" },
        "receiverCountry": { "type": "string" },
        "shipmentType": { "type": "string" },
        "transportMode": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "integer" },
        "weightKg": { "type": "number" },
        "declaredValueUsd": { "type": "number" },
        "estimatedCostUsd": { "type": "number" },
        "pickupType": { "type": "string" },
        "deliveryType": { "type": "string" },
        "status": { "type": "string" },
        "currentLocation": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "shipmentDate": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["trackingNumber", "senderEmail", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles synchronized across web and mobile"
    },
    "/shipments/{shipmentId}": {
      "schema": { "$ref": "#/entities/Shipment" },
      "description": "Shipments booked across web portal and mobile app"
    }
  }
}
